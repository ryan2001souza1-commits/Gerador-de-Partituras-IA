# Worker de áudio — variáveis de ambiente (somente nomes, sem valores)
# Copie para .env e preencha os valores reais.
# NUNCA commitar .env com segredos reais.

# Obrigatória: segredo compartilhado entre API (Vercel) e Worker (RunPod)
# Usado para assinar/validar HMAC do callback webhook.
WORKER_WEBHOOK_SECRET=

# Porta HTTP (o Dockerfile expõe 8001; RunPod injeta PORT automaticamente)
PORT=8001

# Opcionais (têm defaults no config.py):
# AUDIO_TMP_DIR=/tmp/gpi
# AUDIO_MAX_BYTES=26214400
# AUDIO_DOWNLOAD_TIMEOUT_S=30
# AUDIO_NORMALIZE_TIMEOUT_S=120
# DEMUCS_MODEL=htdemucs
# DEMUCS_DEVICE=auto
# DEMUCS_TIMEOUT_S=600
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# CALLBACK_URL=
# CALLBACK_TOKEN=